using std{};

fun print_array(array: [int]) {
  val i = 0;
  while (i < array.len) {
    println(array[i].to_str());
    i = i + 1;
  }
}

fun fold(array: [int], init: int, acc: fun(int, int) -> int) -> int {
  val i = 0;
  while (i < array.len) {
    init = acc(init, array[i]);
    i = i + 1;
  }
  return init;
}

fun map(array: [int], mapper: fun(int) -> int) {
  val i = 0;
  while (i < array.len) {
    array[i] = mapper(array[i]);
    i = i + 1;
  }
}

fun sum(l: int, r: int) -> int {
  return l + r;
}

fun largest(l: int, r: int) -> int {
  if (l > r) {
    return l;
  } else {
    return r;
  }
}

fun double(value: int) -> int {
  return value * 2;
}

fun main() {
  val array = [3, 8, 11, -28];
  print_array(array);
  println("");

  println("Sum is: ");
  println(fold(array, 0, sum).to_str());
  println("");

  println("Largest is: ");
  println(fold(array, 0, largest).to_str());
  println("");

  map(array, double);
  println("Doubled is: ");
  print_array(array);
}

