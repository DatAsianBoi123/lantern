primitive byte;
primitive int;

native fun int.to_str(self: int) -> String;

@std(string)
struct String {
  bytes: [byte],
}

fun print(str: String) {
  write(str.bytes);
  write("\n".bytes);
  flush();
}

native fun write(str: [byte]);
native fun flush();

fun print_array(array: [int]) {
  val i = 0;
  while (i < array.len) {
    print(array[i].to_str());
    i = i + 1;
  }
}

fun fold(array: [int], init: int, acc: fun(int, int) -> int) -> int {
  val i = 0;
  while (i < array.len) {
    init = acc(init, array[i]);
    i = i + 1;
  }
  return init;
}

fun map(array: [int], mapper: fun(int) -> int) {
  val i = 0;
  while (i < array.len) {
    array[i] = mapper(array[i]);
    i = i + 1;
  }
}

fun sum(l: int, r: int) -> int {
  return l + r;
}

fun largest(l: int, r: int) -> int {
  if (l > r) {
    return l;
  } else {
    return r;
  }
}

fun double(value: int) -> int {
  return value * 2;
}

val array = [3, 8, 11, -28];
print_array(array);
print("");

print("Sum is: ");
print(fold(array, 0, sum).to_str());
print("");

print("Largest is: ");
print(fold(array, 0, largest).to_str());
print("");

map(array, double);
print("Doubled is: ");
print_array(array);

