primitive byte;
primitive int;

fun print(str: [byte]) {
  write(str);
  write("\n");
  flush();
}

native fun write(str: [byte]);
native fun flush();
native fun int_to_str(int: int) -> [byte];

fun print_array(array: [int]) {
  val i = 0;
  while (i < array.len) {
    print(int_to_str(array[i]));
    i = i + 1;
  }
}

fun fold(array: [int], init: int, acc: fun(int, int) -> int) -> int {
  val i = 0;
  while (i < array.len) {
    init = acc(init, array[i]);
    i = i + 1;
  }
  return init;
}

fun map(array: [int], mapper: fun(int) -> int) {
  val i = 0;
  while (i < array.len) {
    array[i] = mapper(array[i]);
    i = i + 1;
  }
}

fun sum(l: int, r: int) -> int {
  return l + r;
}

fun largest(l: int, r: int) -> int {
  if (l > r) {
    return l;
  } else {
    return r;
  }
}

fun double(value: int) -> int {
  return value * 2;
}

val array = [3, 8, 11, -28];
print_array(array);
print("");

print("Sum is: ");
print(int_to_str(fold(array, 0, sum)));
print("");

print("Largest is: ");
print(int_to_str(fold(array, 0, largest)));
print("");

map(array, double);
print("Doubled is: ");
print_array(array);

