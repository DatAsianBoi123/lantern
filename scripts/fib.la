primitive byte;
primitive int;

native fun int.to_str(self: int) -> String;

@std(string)
struct String {
  bytes: [byte],
}

fun println(str: String) {
  write(str.bytes);
  write("\n".bytes);
  flush();
}

native fun write(bytes: [byte]);
native fun flush();

fun fib(n: int) -> int {
  if (n < 2) {
    return n;
  }

  val result = 0;
  val prev1 = 1;
  val prev2 = 0;
  val i = 1;
  while (i < n) {
    result = prev1 + prev2;
    prev2 = prev1;
    prev1 = result;

    i = i + 1;
  }
  return result;
}

fun fib_recursive(n: int) -> int {
  if (n < 2) {
    return n;
  }
  return fib_recursive(n - 1) + fib_recursive(n - 2);
}

println(fib_recursive(20).to_str());

