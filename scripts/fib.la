primitive byte;
primitive int;

native fun write(bytes: [byte]);
native fun flush();
native fun int_to_str(int: int) -> [byte];

fun fib(n: int) -> int {
  if (n < 2) {
    return n;
  }

  val result = 0;
  val prev1 = 1;
  val prev2 = 0;
  val i = 1;
  while (i < n) {
    result = prev1 + prev2;
    prev2 = prev1;
    prev1 = result;

    i = i + 1;
  }
  return result;
}

fun fib_recursive(n: int) -> int {
  if (n < 2) {
    return n;
  }
  return fib_recursive(n - 1) + fib_recursive(n - 2);
}

write(int_to_str(fib_recursive(20)));
write("\n");

