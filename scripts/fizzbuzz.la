primitive byte;
primitive int;

native fun int.to_str(self: int) -> String;
native fun int.from_str(str: String) -> int;

@std(string)
struct String {
  bytes: [byte],
}

fun print(str: String) {
  write(str.bytes);
  write("\n".bytes);
  flush();
}

native fun write(x: [byte]);
native fun flush();
native fun input_int() -> int;

print("Enter max:");
val max = int.from_str(input());

val index = 1;
while (index <= max) {
  fizzbuzz(index);
  index = index + 1;
}

fun fizzbuzz(x: int) {
  if (x % 5 == 0 && x % 3 == 0) {
    print("FizzBuzz");
  } else if (x % 5 == 0) {
    print("Buzz");
  } else if (x % 3 == 0) {
    print("Fizz");
  } else {
    print(x.to_str());
  }
}

