using std{};

fun fizzbuzz(x: int) {
  if (x % 5 == 0 && x % 3 == 0) {
    println("FizzBuzz");
  } else if (x % 5 == 0) {
    println("Buzz");
  } else if (x % 3 == 0) {
    println("Fizz");
  } else {
    println(x.to_str());
  }
}

fun main() {
  println("Enter max:");
  val max = int.from_str(input());

  val index = 1;
  while (index <= max) {
    fizzbuzz(index);
    index = index + 1;
  }
}

