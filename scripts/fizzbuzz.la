primitive byte;
primitive int;

native fun print(x: [byte]);
native fun int_to_str(int: int) -> [byte];
native fun input_int() -> int;

val index: int = 1;

print("Enter max:");
val max: int = input_int();

while (index <= max) {
  fizzbuzz(index);
  index = index + 1;
}

fun fizzbuzz(x: int) {
  if (x % 5 == 0 && x % 3 == 0) {
    print("FizzBuzz");
  } else if (x % 5 == 0) {
    print("Buzz");
  } else if (x % 3 == 0) {
    print("Fizz");
  } else {
    print(int_to_str(x));
  }
}

