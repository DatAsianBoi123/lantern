primitive byte;
primitive int;
primitive float;

native fun float.to_str(self: float) -> String;

@std(string)
struct String {
  bytes: [byte],
}

native fun String.concat(self: String, str: String) -> String;

fun print(str: String) {
  write(str.bytes);
  write("\n".bytes);
  flush();
}

native fun write(x: [byte]);
native fun flush();
native fun gc();

struct Position {
  name: String,
  x: float,
  y: float,
}

val my_pos = Position {
  name: "hi",
  x: 5.2,
  y: -55.11,
};

fun Position.print(self: Position) {
  print("name: ".concat(self.name));
  print("x: ".concat(self.x.to_str()));
  print("y: ".concat(self.y.to_str()));
}

my_pos.print();

print("");

my_pos.x = my_pos.x * 2.0;
my_pos.y = 5.28;
my_pos.print();

