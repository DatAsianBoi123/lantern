native byte;
native int;
native float;
native fun float.to_str(self: float) -> str;

native str;
native fun str.concat(self: str, str: str) -> str;

fun print(str: str) {
  write(str);
  write("\n");
  flush();
}

native fun write(str: str);
native fun flush();
native fun gc();

struct Position {
  name: str,
  x: float,
  y: float,
}

val my_pos = Position {
  name: "hi",
  x: 5.2,
  y: -55.11,
};

fun Position.print(self: Position) {
  print("name: ".concat(self.name));
  print("x: ".concat(self.x.to_str()));
  print("y: ".concat(self.y.to_str()));
}

my_pos.print();

print("");

my_pos.x = my_pos.x * 2.0;
my_pos.y = 5.28;
my_pos.name = "ho ho ho";
my_pos.print();

