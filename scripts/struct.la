primitive byte;
primitive int;
primitive float;

fun print(str: [byte]) {
  write(str);
  write("\n");
  flush();
}

native fun write(x: [byte]);
native fun flush();
native fun float_to_str(float: float) -> [byte];

struct Position {
  name: [byte],
  x: float,
  y: float,
}

val my_pos: Position = Position {
  name: "hi",
  x: 5.2,
  y: -55.11,
};

fun Position.print(pos: Position) {
  print("name:");
  print(pos.name);
  print("x:");
  print(float_to_str(pos.x));
  print("y:");
  print(float_to_str(pos.y));
}

Position.print(my_pos);

print("");

my_pos.x = my_pos.x * 2.0;
my_pos.y = 5.28;
Position.print(my_pos);

