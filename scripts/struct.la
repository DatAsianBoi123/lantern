using std{};

struct Position {
  name: str,
  x: float,
  y: float,
}

fun Position.print(self: Position) {
  println("name: ".concat(self.name));
  println("x: ".concat(self.x.to_str()));
  println("y: ".concat(self.y.to_str()));
}

fun main() {
  val my_pos = Position {
    name: "hi",
    x: 5.2,
    y: -55.11,
  };

  my_pos.print();

  println("");

  my_pos.x = my_pos.x * 2.0;
  my_pos.y = 5.28;
  my_pos.name = "ho ho ho";
  my_pos.print();
}

