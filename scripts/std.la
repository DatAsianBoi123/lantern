pub native byte;

pub native int;
pub fun int.abs(self: int) -> int {
  if (self < 0) {
    return -self;
  } else {
    return self;
  }
}
pub native fun int.to_str(self: int) -> str;
pub native fun int.from_str(str: str) -> int;

pub native float;
pub fun float.inverse(self: float) -> float {
  return 1.0 / self;
}
pub native fun float.to_str(self: float) -> str;
pub native fun float.from_str(str: str) -> float;

pub native bool;

pub native str;
pub native fun str.concat(self: str, str: str) -> str;

pub fun println(str: str) {
  write(str);
  write("\n");
  flush();
}

pub native fun write(str: str);
pub native fun flush();
pub native fun input() -> str;

