primitive byte;

primitive int;
fun int.abs(self: int) -> int {
  if (self < 0) {
    return -self;
  } else {
    return self;
  }
}
native fun int.to_str(self: int) -> String;

primitive float;
fun float.inverse(self: float) -> float {
  return 1.0 / self;
}
native fun float.to_str(self: float) -> String;

primitive bool;

@std(string)
struct String {
  bytes: [byte],
}
fun String.char_len(self: String) -> int {
  return self.bytes.len;
}
fun String.char_at(self: String, at: int) -> byte {
  return self.bytes[at];
}
fun String.replace_first(self: String, other: String) {
  self.bytes[0] = other.bytes[0];
}

fun println(str: String) {
  write(str.bytes);
  write("\n".bytes);
  flush();
}

native fun write(bytes: [byte]);
native fun flush();
native fun input_float() -> float;
native fun input_int() -> int;

