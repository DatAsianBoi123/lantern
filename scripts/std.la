primitive byte;

primitive int;
fun int.abs(self: int) -> int {
  if (self < 0) {
    return -self;
  } else {
    return self;
  }
}

primitive float;
fun float.inverse(self: float) -> float {
  return 1.0 / self;
}

primitive bool;

struct String {
  bytes: [byte],
}
fun String.replace_first(self: String, other: [byte]) {
  self.bytes[0] = other[0];
}

fun println(str: String) {
  write(str.bytes);
  write("\n");
  flush();
}

native fun write(bytes: [byte]);
native fun flush();
native fun int_to_str(int: int) -> [byte];
native fun float_to_str(float: float) -> [byte];
native fun input_float() -> float;
native fun input_int() -> int;

