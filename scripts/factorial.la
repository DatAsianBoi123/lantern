using std{};

fun factorial(num: int) -> int {
  if (num == 0 || num == 1) {
    return 1;
  }

  return num * factorial(num - 1);
}

fun main() {
  println("Enter number:");
  val num = int.from_str(input());
  if (num < 0) {
    throw "cannot take the factorial of a negative number";
  }
  println("Factorial is:");
  println(factorial(num).to_str());
}

