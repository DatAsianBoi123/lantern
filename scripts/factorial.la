primitive byte;
primitive int;

native fun int.to_str(self: int) -> String;
native fun int.from_str(str: String) -> int;

@std(string)
struct String {
  bytes: [byte],
}

fun print(str: String) {
  write(str.bytes);
  write("\n".bytes);
  flush();
}

native fun write(x: [byte]);
native fun flush();
native fun input() -> String;

fun factorial(num: int) -> int {
  if (num == 0 || num == 1) {
    return 1;
  }

  return num * factorial(num - 1);
}

print("Enter number:");
val num = int.from_str(input());
print("Factorial is:");
print(factorial(num).to_str());

