primitive byte;
primitive int;

fun print(str: [byte]) {
  write(str);
  write("\n");
  flush();
}

native fun write(x: [byte]);
native fun flush();
native fun int_to_str(x: int) -> [byte];
native fun input_int() -> int;

fun factorial(num: int) -> int {
  if (num == 0 || num == 1) {
    return 1;
  }

  return num * factorial(num - 1);
}

print("Enter number:");
val num: int = input_int();
print("Factorial is:");
print(int_to_str(factorial(num)));

