primitive int;
primitive byte;
primitive bool;

native fun int.to_str(self: int) -> String;

@std(string)
struct String {
  bytes: [byte],
}

native fun write(bytes: [byte]);
native fun flush();
native fun gc();

fun print(str: String) {
  write(str.bytes);
  flush();
}

fun println(str: String) {
  write(str.bytes);
  write("\n".bytes);
  flush();
}

struct Node {
  value: int,
  next: ?Node,
}
fun Node.new(value: int) -> Node {
  return Node {
    value: value,
    next: none,
  };
}

struct LinkedList {
  root: ?Node,
  len: int,
}
fun LinkedList.new() -> LinkedList {
  return LinkedList {
    root: none,
    len: 0,
  };
}
fun LinkedList.push(self: LinkedList, int: int) {
  match (self.last()) {
    last => {
      last.next = Node.new(int);
    }
    ? => {
      self.root = Node.new(int);
    }
  }
  self.len = self.len + 1;
}
fun LinkedList.last(self: LinkedList) -> ?Node {
  val node = self.root;
  match (node) {
    ? => {
      return none;
    }
    node => {
      while (true) {
        match (node.next) {
          next => {
            node = next;
          }
          ? => {
            break;
          }
        }
      }
      return node;
    }
  }
}
fun LinkedList.for_each(self: LinkedList, fn: fun(LinkedList, int, int)) {
  val i = 0;
  val node = self.root;
  while (true) {
    match (node) {
      next => {
        fn(self, i, next.value);
        node = next.next;
        i += 1;
      }
      ? => {
        break;
      }
    }
  }
}
fun LinkedList.display(self: LinkedList) {
  fun fmt(list: LinkedList, i: int, int: int) {
    print(int.to_str());
    if (i != list.len - 1) {
      print(", ");
    }
  }

  print("[");
  self.for_each(fmt);
  print("]\n");
  flush();
}

val mylist = LinkedList.new();
val i = 1;
while (i < 100) {
  mylist.push(i);
  i += 1;
}
mylist.display();

