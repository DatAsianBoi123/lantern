using foo{Foo, Foo.display};
using foo.bar{Bar, Bar.compute, Bar.display};

pub native int;
pub native float;
pub native str;

pub native fun str.concat(self: str, other: str) -> str;
pub native fun int.to_str(self: int) -> str;
pub native fun float.to_str(self: float) -> str;

pub native fun write(str: str);
pub native fun flush();

fun println(str: str) {
  write(str);
  write("\n");
  flush();
}

fun main() {
  val foo = Foo {
    bar: 12,
    qux: 3.2,
  };
  val bar = Bar {
    foo: foo,
    mult: 2.0,
  };

  println(foo.display());
  println("bar is ".concat(foo.bar.to_str()));
  println(bar.display());
  println(bar.compute().display());
}

