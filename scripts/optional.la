using std{};

fun (?float).or(self: ?float, other: float) -> float {
  match (self) {
    num => {
      return num;
    }
    ? => {
      return other;
    }
  }
}

fun float.reciprocal(self: float) -> ?float {
  if (self == 0.0) {
    return;
  }
  return (1.0 / self);
}

fun main() {
  while (true) {
    val num = float.from_str(input());
    val inverse = num.reciprocal();
    match (inverse) {
      num => {
        println("reciprocal is ".concat(num.to_str()));
      }
      ? => {
        println("cannot take the reciprocal of 0");
      }
    }
    println(inverse.or(0.0).to_str());
  }
}

